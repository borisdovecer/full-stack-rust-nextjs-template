# /etc/app/api.env on the server (owner root:app, mode 640). Never commit the real file.
APP_ENV=production
DATABASE_URL=postgres://app:CHANGE_ME@127.0.0.1:5432/app
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_SECONDS=30
API_BIND=127.0.0.1:8080
APP_CONFIG=/etc/app/app.toml
RUST_LOG=info,sqlx=warn,tower_http=info
SENTRY_DSN=
RESEND_API_KEY=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_SECRET=
