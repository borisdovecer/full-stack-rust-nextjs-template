# Copy to .env.local (gitignored). Only NEXT_PUBLIC_* values reach the browser: never put a
# secret in one of those. The web holds no secrets at all.

# Where the Rust API listens. In development `/api/*` is forwarded there; in production Caddy
# sends `/api/*` to the API directly and this is only a fallback. Read when `next dev` starts,
# and baked into a production build at `next build` time.
API_URL=http://127.0.0.1:8080

# Port for `npm run dev` and `npm run start`.
WEB_PORT=3000

# Sentry for the browser. Empty = off.
NEXT_PUBLIC_SENTRY_DSN=
