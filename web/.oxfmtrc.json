{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    "node_modules",
    ".next",
    "out",
    "coverage",
    "package-lock.json",
    "next-env.d.ts",
    "src/lib/api/schema.d.ts"
  ]
}
