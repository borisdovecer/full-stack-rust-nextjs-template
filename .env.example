# Copy to .env (gitignored). Secrets live here and nowhere else.
# Non-secret settings are in config/app.toml.

# development | production. Production turns on Secure cookies, JSON logs,
# embedded help docs, and refuses unsafe settings.
APP_ENV=development

# Postgres. The database name is the project's name (`app` until scripts/rename.sh runs).
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/app

# Database pool, per API process. All instances' pools together must stay below Postgres'
# max_connections (100 by default). Statement timeout 0 = none; `app-api migrate` never has one.
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_SECONDS=30

# Where the API listens. Loopback only, unless APP_ENV=production and you mean it.
API_BIND=127.0.0.1:8080

# Log filter (tracing env filter syntax).
RUST_LOG=info,sqlx=warn,tower_http=info

# Sentry for the API. Empty = off.
SENTRY_DSN=

# Resend's API key for the sign-in codes. Empty = codes are written to the API log, which works
# only in development; in production the email-code method is then turned off.
RESEND_API_KEY=

# Client secrets for "Continue with Google / GitHub". Each provider is on when its secret here
# and its client_id in config/app.toml are set. See docs/system/auth.md.
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_SECRET=

# The first admin's sign-in, written by scripts/setup.sh when it creates that admin.
# Used only by skills/app-api in development. Never set these on a server.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The team's Telegram report chat, used only by skills/app-dev in development.
# The bot token from @BotFather and the chat's id (a group's starts with -).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
